{% sw_extends '@Storefront/storefront/layout/header/actions/cart-widget.html.twig' %}

{% block layout_header_actions_cart_widget %}
    <span class="header-cart-icon">
        {% sw_icon 'bag' %}
    </span>
    {% if page.cart.lineItems|length > 0 %}
        <span class="badge bg-primary header-cart-badge">{{ page.cart.lineItems|length }}</span>
    {% endif %}
{#    {{ page.extensions.dasGrossNetConfig.get('grossNetSwitch')) }}#}
    <span class="header-cart-total">
        <span class="gross-net--toggle net{% if page.extensions.dasGrossNetConfig.get('grossNetSwitch') is true %} d-none{% endif %}">{{ page.cart.price.netPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
        <span class="gross-net--toggle gross{% if page.extensions.dasGrossNetConfig.get('grossNetSwitch') is not true %} d-none{% endif %}">{{ page.cart.price.positionPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
    </span>
{% endblock %}
