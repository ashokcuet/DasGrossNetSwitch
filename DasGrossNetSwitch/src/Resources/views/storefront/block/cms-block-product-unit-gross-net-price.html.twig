{% if config('DasGrossNetSwitch.config.active') %}
    {% set grossNetSwitch = page.extensions.dasGrossNetConfig.grossNetSwitch %}
    {% set dasPrice = product.price.elements|first %}
    {% set referencePrice = product.calculatedPrice.referencePrice %}
    {% set price = {
        "gross": (dasPrice.gross * product.referenceUnit) / product.purchaseUnit,
        "net": (dasPrice.net * product.referenceUnit) / product.purchaseUnit
    } %}
    <span class="gross-net--level">{{ "das_gross_net.product.detail.BasicPrice"|trans|sw_sanitize }}</span>
    <span class="gross-net--toggle gross{% if grossNetSwitch is not true %} d-none{% endif %}">{{ price.gross|currency }}{{ "general.star"|trans|sw_sanitize }} / {{ referencePrice.referenceUnit }} {{ product.unit.shortCode }}</span>
    <span class="gross-net--toggle net{% if grossNetSwitch is true %} d-none{% endif %}">{{ price.net|currency }}{{ "general.star"|trans|sw_sanitize }} / {{ referencePrice.referenceUnit }} {{ product.unit.shortCode }}</span>
{% else %}
    ({{ referencePrice.price|currency }}{{ "general.star"|trans|sw_sanitize }} / {{ referencePrice.referenceUnit }} {{ referencePrice.unitName }})
{% endif %}
