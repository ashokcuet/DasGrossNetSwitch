{% sw_extends '@Storefront/storefront/layout/navigation/offcanvas/navigation.html.twig' %}

{% block layout_navigation_offcanvas_navigation_actions %}
    {{ parent() }}
    {% if config('DasGrossNetSwitch.config.active') %}
        {% block netkitchen_gross_net_switch_desktop %}
            <div class="d-das-sm-none d-das-md-block das-gross-net-switch">
                <div class="form-check form-switch gross-net-switch" data-offcanvas-gross-net-switch="true">
                    <span class="d-none debug-session">{{ page.extensions.dasGrossNetConfig.grossNetSwitch|json_encode }}</span>
                    <input class="form-check-input form-check-input-menu" type="checkbox" id="grossNetToggleOffcanvas" {% if page.extensions.dasGrossNetConfig.grossNetSwitch %}checked{% endif %}>
                    <label class="form-check-label gross-net--toggle gross{% if page.extensions.dasGrossNetConfig.get('grossNetSwitch') is false %} d-none{% endif %}" for="grossNetToggle1">{{ "DasGrossNetSwitch.inputField.label.gross"|trans }}</label>
                    <label class="form-check-label gross-net--toggle net{% if page.extensions.dasGrossNetConfig.get('grossNetSwitch') is true %} d-none{% endif %}" for="grossNetToggle1">{{ "DasGrossNetSwitch.inputField.label.net"|trans }}</label>
                </div>
            </div>
        {% endblock %}
    {% endif %}
{% endblock %}
