{% sw_extends '@Storefront/storefront/component/line-item/element/unit-price.html.twig' %}

{% block component_line_item_unit_price_inner %}
    {% set unitNetPrice = (lineItem.price.unitPrice - (lineItem.price.unitPrice * lineItem.price.calculatedTaxes|first.taxRate/100)) %}
    <div class="line-item-unit-price-value">
        <span class="gross-net--toggle net{% if page.extensions.dasGrossNetConfig.grossNetSwitch is true %} d-none{% endif %}">{{ unitNetPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
        <span class="gross-net--toggle gross{% if page.extensions.dasGrossNetConfig.grossNetSwitch is false %} d-none{% endif %}">{{ lineItem.price.unitPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
        <span class="line-item-unit-price-value-descriptor"> / {{ 'checkout.lineItemUnitPriceDescriptor'|trans|sw_sanitize }}</span>
    </div>
{% endblock %}
