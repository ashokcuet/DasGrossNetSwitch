{% sw_extends '@Storefront/storefront/page/checkout/summary/summary-total.html.twig' %}

{% block page_checkout_summary_total_value %}
    {% set netPrice = summary.price.rawTotal - (summary.price.rawTotal *  summary.price.calculatedTaxes|first.taxRate/100) %}
    <dd class="col-5 checkout-aside-summary-value checkout-aside-summary-total">
        <div style="display: none">
            {{ summary.price|json_encode(constant('JSON_PRETTY_PRINT')) }}
        </div>
        <span class="gross-net--toggle gross{% if page.extensions.dasGrossNetConfig.grossNetSwitch is false %} d-none{% endif %}">{{ summary.price.rawTotal|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
        <span class="gross-net--toggle net{% if page.extensions.dasGrossNetConfig.grossNetSwitch is true %} d-none{% endif %}">{{ netPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
    </dd>
{% endblock %}