{% sw_extends '@Storefront/storefront/page/checkout/summary/summary-shipping.html.twig' %}

{% block page_checkout_summary_shipping_value %}
    {% set netPrice = delivery.shippingCosts.totalPrice - (delivery.shippingCosts.totalPrice * delivery.shippingCosts.calculatedTaxes|first.taxRate/100) %}
    <dd class="col-5 checkout-aside-summary-value">
        <div style="display: none">
            {{ delivery.shippingCosts|json_encode(constant('JSON_PRETTY_PRINT')) }}
        </div>
        <span class="gross-net--toggle gross{% if page.extensions.dasGrossNetConfig.grossNetSwitch is false %} d-none{% endif %}">{{ delivery.shippingCosts.totalPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
        <span class="gross-net--toggle net{% if page.extensions.dasGrossNetConfig.grossNetSwitch is true %} d-none{% endif %}">{{ netPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
    </dd>
{% endblock %}
