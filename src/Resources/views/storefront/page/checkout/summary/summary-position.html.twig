{% sw_extends '@Storefront/storefront/page/checkout/summary/summary-position.html.twig' %}

{% block page_checkout_summary_position_value %}
    {% set netPrice = 0 %}
    {% for lineItem in summary.lineItems %}
        {% set netPrice = netPrice + (lineItem.price.totalPrice - (lineItem.price.totalPrice * lineItem.price.calculatedTaxes|first.taxRate/100)) %}
    {% endfor %}
    <dd class="col-5 checkout-aside-summary-value">
        <span class="gross-net--toggle gross{% if page.extensions.dasGrossNetConfig.get('grossNetSwitch') is false %} d-none{% endif %}">{{ summary.price.positionPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
        <span class="gross-net--toggle net{% if page.extensions.dasGrossNetConfig.get('grossNetSwitch') is true %} d-none{% endif %}">{{ netPrice|currency }}{{ "general.star"|trans|sw_sanitize }}</span>
    </dd>
{% endblock %}
